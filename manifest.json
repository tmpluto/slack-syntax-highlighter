{
  "name": "Slack Syntax Highlighter",
  "manifest_version": 3,
  "version": "1.0.0",
  "description": "Add syntax highlighting to code blocks in Slack",
  "content_scripts": [
    {
      "matches": [
        "https://*.slack.com/*",
        "https://app.slack.com/*",
        "https://slack.com/*"
      ],
      "css": ["highlight.css"],
      "js": ["highlight.bundle.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
	"16": "icons/icon16.png",
	"32": "icons/icon32.png",
	"48": "icons/icon48.png",
	"128": "icons/icon128.png"
  },
  "homepage_url": "https://github.com/tmpluto/slack-syntax-highlighter"
}

